<Window x:Class="AirPrinter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirPrinter"
        Icon="Assets/app-icon.png"
        Width="1080"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FFFFFF"
        FontFamily="SF Pro Text, SF Pro Display, Segoe UI"
        FontSize="15"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="FocusRing" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Rectangle Margin="-3" RadiusX="14" RadiusY="14" Stroke="#4037A2EA" StrokeThickness="3" Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E6F4FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="#1A000000" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#1A000000"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F5F7FA" BorderBrush="#0F000000" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,16">
                <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}" Click="ShowHome_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/app-icon.png" Width="28" Height="28" Margin="0,0,10,0"/>
                        <TextBlock Text="AirPrinter" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Top" Margin="0,18,0,0">
                    <Button x:Name="NavPrinter" Style="{StaticResource NavButton}" Content="Принтер" Click="ShowPrinter_Click"/>
                    <Button x:Name="NavDocs" Style="{StaticResource NavButton}" Content="Документация" Click="ShowDocs_Click"/>
                    <Button x:Name="NavDriver" Style="{StaticResource NavButton}" Content="Драйвер" Click="ShowDriver_Click"/>
                    <Button x:Name="NavLog" Style="{StaticResource NavButton}" Content="Журнал" Click="ShowLog_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="HomePage" Grid.Column="1" Background="#FFFFFF">
            <Button x:Name="PowerButton" Width="240" Height="240" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                    Click="Power_Click" PreviewMouseLeftButtonDown="Power_PreviewMouseDown">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Glass" Width="240" Height="240" CornerRadius="36" BorderThickness="1" BorderBrush="#8CFFFFFF" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F7FFFFFF" Offset="0"/>
                                    <GradientStop Color="#C8F5F7FA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.08" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Ellipse Width="168" Height="168" Fill="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.FontSize="22" TextBlock.FontWeight="SemiBold"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glass" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Canvas x:Name="RippleCanvas" Background="Transparent" IsHitTestVisible="False"/>
        </Grid>

        <ScrollViewer x:Name="PrinterPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
            <StackPanel MaxWidth="640" Margin="48,40">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Принтер"/>
                <DockPanel Margin="0,20,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Обновить" Click="RefreshPrinters_Click"/>
                    <ComboBox x:Name="PrinterCombo" DisplayMemberPath="Name" SelectionChanged="PrinterCombo_SelectionChanged"/>
                </DockPanel>
                <TextBlock x:Name="PrinterDetailsText" Margin="0,14,0,0" Foreground="#6E6E73"/>
                <CheckBox x:Name="ShareBox" Margin="0,18,0,10" Content="Сделать принтер общедоступным" Checked="ShareBox_Changed" Unchecked="ShareBox_Changed"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" Text="Имя ресурса"/>
                    <TextBox x:Name="ShareNameBox" TextChanged="ShareNameBox_TextChanged"/>
                </DockPanel>
                <Button Margin="0,18,0,0" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Content="Пробная страница" Click="TestPage_Click"/>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DocsPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
            <StackPanel MaxWidth="680" Margin="48,40">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Документация"/>
                <TextBlock Margin="0,18,0,0" FontSize="17" Foreground="#6E6E73" Text="Принтер подключается к этому компьютеру своим драйвером Windows. iPhone печатает через AirPrint, Android — через свою службу печати IPP. Оба задания попадают в одну очередь Windows и печатаются по очереди."/>
                <TextBlock Margin="0,14,0,0" FontSize="17" Foreground="#6E6E73" Text="Пакет Apple ставит службу Bonjour. Сам мастер Bonjour принтер для iPhone не создаёт — это делает кнопка на главном экране."/>
                <TextBlock Margin="0,14,0,0" FontSize="17" Foreground="#6E6E73" Text="Пробная страница идёт в очередь Windows и проверяет USB-драйвер, не iPhone."/>
                <TextBlock Margin="0,14,0,0" FontSize="17" Foreground="#6E6E73" Text="Телефон и компьютер должны быть в одной подсети. Пока мост включён, не уводите компьютер в сон."/>
                <TextBlock Margin="0,14,0,0" FontSize="17" Foreground="#6E6E73" Text="Белая кнопка означает, что мост выключен. Синяя — он работает. Красная — последняя попытка включить или выключить его завершилась ошибкой."/>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DriverPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
            <StackPanel MaxWidth="640" Margin="48,40">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Драйвер"/>
                <TextBlock x:Name="BonjourStatusText" Margin="0,18,0,0" FontSize="17" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="RecheckBonjourButton" Style="{StaticResource QuietButton}" Content="Проверить снова" Click="RecheckBonjour_Click"/>
                    <Button x:Name="DownloadBonjourButton" Style="{StaticResource QuietButton}" Content="Скачать Bonjour" Click="DownloadBonjour_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LogPage" Grid.Column="1" Visibility="Collapsed" Background="#FFFFFF">
            <DockPanel Margin="32">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" FontSize="28" FontWeight="SemiBold" Text="Журнал"/>
                <ListBox x:Name="LogList" FontFamily="Cascadia Mono, Consolas" FontSize="14" BorderThickness="0" Background="#F5F7FA"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
