# User service. A GUI process needs the logged-in graphical session.
# Do not install this file under /etc/systemd/system.
[Unit]
Description=APS for iOS (GUI)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/opt/aps
ExecStart=/opt/aps/aps-launcher
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
